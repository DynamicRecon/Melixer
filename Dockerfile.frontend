FROM node:20-slim AS builder

WORKDIR /app

# Install dependencies
COPY frontend/package*.json ./
RUN npm ci

# Copy source
COPY frontend/ .

# Create production env
ARG REACT_APP_API_URL
ENV REACT_APP_API_URL=$REACT_APP_API_URL

# Build
RUN npm run build

# --- Production stage ---
FROM nginx:alpine

# Copy React build to Nginx
COPY --from=builder /app/build /usr/share/nginx/html

# Copy Nginx config
COPY nginx/melixer.conf /etc/nginx/conf.d/default.conf

# Copy SSL certs
COPY nginx/certs/melixer.crt /etc/ssl/certs/melixer.crt
COPY nginx/certs/melixer.key /etc/ssl/private/melixer.key

EXPOSE 80 443 3443

CMD ["nginx", "-g", "daemon off;"]