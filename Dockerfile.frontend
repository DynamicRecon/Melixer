# Build stage
FROM node:20-slim AS builder

WORKDIR /app

COPY frontend/package*.json /app/
RUN npm ci

ARG REACT_APP_API_URL
ENV REACT_APP_API_URL=$REACT_APP_API_URL

COPY frontend/ /app
RUN npm run build

# Production stage
FROM nginx:alpine

# Install openssl to generate certs
RUN apk add --no-cache openssl

# Generate self-signed certificate
RUN mkdir -p /etc/ssl/certs /etc/ssl/private && \
    openssl genrsa -out /etc/ssl/private/melixer.key 2048 && \
    openssl req -x509 -nodes -days 365 \
        -key /etc/ssl/private/melixer.key \
        -out /etc/ssl/certs/melixer.crt \
        -subj "/C=US/ST=Tennessee/L=Blountville/O=Melixer/CN=melixer.roseweb.local" \
        -addext "subjectAltName=DNS:melixer.roseweb.local,DNS:localhost,IP:10.0.0.250"

# Copy React build from builder stage
COPY --from=builder /app/build /usr/share/nginx/html

# Copy Nginx config
COPY nginx/melixer.conf /etc/nginx/conf.d/default.conf

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
